#!/usr/bin/env bash
# Prepend a new "now" line to _data/now.yml, dated today.
# Usage: ./bin/now "In Tokyo, learning to develop film"
set -euo pipefail
[ $# -ge 1 ] || { echo "usage: ./bin/now \"In <city>, <doing> <x>\""; exit 1; }
text="$*"
file="$(cd "$(dirname "$0")/.." && pwd)/_data/now.yml"
today="$(date +%F)"
entry="- date: ${today}\n  text: \"${text}\""
# Insert the new entry directly above the first existing "- date:" line.
awk -v e="$entry" '!done && /^- date:/ { printf "%s\n", e; done=1 } { print }' "$file" > "$file.tmp" && mv "$file.tmp" "$file"
echo "added: ${today} — ${text}"
